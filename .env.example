# ---------------------------------------------------------------------------
# Climb & Slide environment variables
#
# Local Multiplayer and Bot modes work with NO configuration at all.
# Only Online Multiplayer needs the value below.
# ---------------------------------------------------------------------------

# Public — safe to expose in the browser bundle.
#
# Local dev (`npm run dev`) serves Socket.io from the same origin, so leave
# this UNSET. When you deploy the UI to Vercel and run the realtime server
# elsewhere (Render / Railway / VPS via `npm run realtime`), point to it here:
NEXT_PUBLIC_SOCKET_URL=

# Optional: absolute origin used for canonical URLs / OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
